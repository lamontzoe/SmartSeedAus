---
import BaseLayout from '../components/layout/BaseLayout.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

const projects = [
  { title: 'Residential Lawn — Canberra ACT', category: 'Residential', src: 'https://images.unsplash.com/photo-1558904541-efa843a96f01?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Commercial Site — Sydney CBD Fringe', category: 'Commercial', src: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Erosion Control — Hunter Valley', category: 'Erosion Control', src: 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Mine Rehabilitation — Central NSW', category: 'Mine Rehabilitation', src: 'https://images.unsplash.com/photo-1574623452334-1e0ac2b3ccb4?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Hydroseeding Application — Slope', category: 'Hydroseeding', src: 'https://images.unsplash.com/photo-1585320806297-9794b3e4aaae?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'New Home Lawn — Blue Mountains', category: 'Residential', src: 'https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Road Corridor — VIC Highway', category: 'Commercial', src: 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Sporting Field — Geelong VIC', category: 'Commercial', src: 'https://images.unsplash.com/photo-1529778873920-4da4926a72c2?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Hydromulching — Embankment', category: 'Erosion Control', src: 'https://images.unsplash.com/photo-1590212151175-e58edd96185b?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Native Revegetation — Mine Site', category: 'Mine Rehabilitation', src: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Watering Program — Dry Period', category: 'Watering', src: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
  { title: 'Council Streetscape — ACT', category: 'Commercial', src: 'https://images.unsplash.com/photo-1574943320219-553eb213f72d?w=700&q=80&auto=format&fit=crop', w: 700, h: 467 },
];

const categories = ['All', ...Array.from(new Set(projects.map(p => p.category)))];
---

<BaseLayout
  title="Project Gallery"
  description="Browse Smart Seed Australia's project gallery — hydroseeding, hydromulching, mine rehabilitation, and residential lawn projects across NSW, ACT, VIC and Australia."
  breadcrumbs={[
    { name: 'Home', url: 'https://smartseedaustralia.com/' },
    { name: 'Gallery', url: 'https://smartseedaustralia.com/gallery/' },
  ]}
>
  <!-- Page hero -->
  <section class="page-hero" aria-labelledby="gallery-heading">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1440&q=85&auto=format&fit=crop" alt="" width="1440" height="400" loading="eager" fetchpriority="high" />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="container page-hero-inner">
      <span class="text-eyebrow" style="color: var(--color-teal-300);">Our Work</span>
      <h1 id="gallery-heading" style="color:#fff;">Project Gallery</h1>
      <p style="color: var(--color-green-100); max-width: 48ch; font-size: var(--text-lg);">Real results from real projects — across residential, commercial, and mine rehabilitation sites.</p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section">
    <div class="container">
      <!-- Filter tabs -->
      <div class="gallery-filters" role="tablist" aria-label="Filter projects by category">
        {categories.map((cat, i) => (
          <button
            role="tab"
            class:list={['gallery-filter-btn', { active: i === 0 }]}
            data-category={cat}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="gallery-grid" role="list">
        {projects.map((project) => (
          <article
            class="gallery-item"
            data-category={project.category}
            role="listitem"
          >
            <div class="gallery-item-img-wrap">
              <img
                src={project.src}
                alt={project.title}
                width={project.w}
                height={project.h}
                loading="lazy"
                class="gallery-item-img"
              />
              <div class="gallery-item-overlay" aria-hidden="true">
                <span class="gallery-item-category">{project.category}</span>
                <h3 class="gallery-item-title">{project.title}</h3>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    heading="Impressed by Our Work?"
    subheading="Get a free quote for your project. We'll assess your site and deliver results like these."
    primaryLabel="Request a Quote"
  />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 320px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .page-hero-bg { position: absolute; inset: 0; }
  .page-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .page-hero-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, oklch(18% 0.07 148 / 0.88), oklch(24% 0.09 148 / 0.72)); }
  .page-hero-inner { position: relative; z-index: 1; padding-block: clamp(3rem, 6vh, 6rem); display: flex; flex-direction: column; gap: var(--space-4); }

  /* Filters */
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
  }

  .gallery-filter-btn {
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-earth-700);
    background: var(--color-earth-100);
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .gallery-filter-btn.active,
  .gallery-filter-btn:hover {
    background: var(--color-green-700);
    color: #fff;
    border-color: var(--color-green-700);
  }

  /* Gallery grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .gallery-item[data-hidden="true"] { display: none; }

  .gallery-item-img-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 3/2;
    cursor: pointer;
  }

  .gallery-item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .gallery-item:hover .gallery-item-img { transform: scale(1.06); }

  .gallery-item-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, oklch(18% 0.07 148 / 0.85) 0%, transparent 50%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-5);
    opacity: 0;
    transition: opacity var(--duration-normal);
  }

  .gallery-item:hover .gallery-item-overlay { opacity: 1; }

  .gallery-item-category {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-teal-300);
    margin-bottom: var(--space-2);
  }

  .gallery-item-title {
    font-size: var(--text-base);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: var(--leading-snug);
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.dataset.category;

      filterBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      items.forEach(item => {
        const show = category === 'All' || item.dataset.category === category;
        item.setAttribute('data-hidden', show ? 'false' : 'true');
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>
