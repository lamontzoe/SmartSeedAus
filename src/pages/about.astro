---
import BaseLayout from '../components/layout/BaseLayout.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
---

<BaseLayout
  title="About Us"
  description="Smart Seed Australia — Australian-owned hydroseeding specialists with 15+ years of experience across residential, commercial, and mine rehabilitation projects. Servicing NSW, ACT, VIC and all of Australia."
  breadcrumbs={[
    { name: 'Home', url: 'https://smartseedaustralia.com/' },
    { name: 'About', url: 'https://smartseedaustralia.com/about/' },
  ]}
>
  <!-- Page hero -->
  <section class="page-hero" aria-labelledby="about-heading">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1440&q=85&auto=format&fit=crop" alt="" width="1440" height="400" loading="eager" fetchpriority="high" />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="container page-hero-inner">
      <span class="text-eyebrow" style="color: var(--color-teal-300);">Our Story</span>
      <h1 id="about-heading" style="color:#fff;">About Smart Seed Australia</h1>
    </div>
  </section>

  <!-- Story -->
  <section class="section">
    <div class="container about-story">
      <div class="about-story-text">
        <span class="text-eyebrow">Who We Are</span>
        <h2>Growing Australia, One Site at a Time</h2>
        <hr class="divider" />
        <p>Smart Seed Australia was founded with a simple belief: every disturbed, bare, or degraded piece of Australian land deserves the chance to thrive again. Over more than 15 years, we've built a reputation for delivering fast, reliable, and sustainable vegetation establishment — from suburban backyards in Canberra to major mine rehabilitation projects in regional NSW.</p>
        <p>We're an Australian-owned and operated business. Our team includes experienced agronomists, environmental consultants, and field operators who understand Australian soils, climates, and native species. We don't take a one-size-fits-all approach — every project gets a custom seed mix, application strategy, and follow-up plan.</p>
        <p>Whether you're a homeowner wanting a beautiful lawn without the turf price tag, a developer needing fast greencover for council sign-off, or a mine operator with complex environmental obligations — we have the equipment, expertise, and local knowledge to deliver.</p>
      </div>
      <div class="about-story-img">
        <img
          src="https://images.unsplash.com/photo-1529778873920-4da4926a72c2?w=700&q=80&auto=format&fit=crop"
          alt="Smart Seed Australia team working on a hydroseeding project"
          width="700"
          height="520"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Values -->
  <section class="section section--alt" aria-labelledby="values-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Our Approach</span>
        <h2 id="values-heading">What Sets Us Apart</h2>
        <hr class="divider divider--center" />
      </div>
      <div class="values-grid">
        {[
          { icon: '🌿', title: 'Local Knowledge', body: 'We understand Australian climate zones, soil types, native species, and vegetation regulations. No overseas templated approaches — just proven local expertise.' },
          { icon: '⚙️', title: 'Modern Equipment', body: 'Our fleet of hydroseeding and hydromulching machines can handle projects from 100m² residential patches to multi-hectare mine rehabilitation sites.' },
          { icon: '📋', title: 'Documentation & Compliance', body: 'We produce comprehensive seed and application records, germination reports, and environmental compliance documentation for councils, regulators, and project managers.' },
          { icon: '🤝', title: 'End-to-End Service', body: 'From initial site assessment and seed mix design through to application, follow-up watering, and establishment monitoring — we\'re with you the whole way.' },
          { icon: '🌱', title: 'Sustainable Outcomes', body: 'We prioritise seed mixes that create long-term, self-sustaining ecosystems — not just quick cover that fades. Especially critical for erosion control and mine rehabilitation.' },
          { icon: '📍', title: 'Australia-Wide Reach', body: 'Based in NSW, with primary focus on NSW, ACT and VIC, but we travel for the right project. We\'ve worked in every state and territory across Australia.' },
        ].map(v => (
          <div class="value-card">
            <span class="value-icon" aria-hidden="true">{v.icon}</span>
            <h3 class="value-title">{v.title}</h3>
            <p class="value-body">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service areas -->
  <section class="section" aria-labelledby="areas-heading">
    <div class="container">
      <div class="section-header">
        <span class="text-eyebrow">Where We Work</span>
        <h2 id="areas-heading">Service Areas</h2>
        <hr class="divider divider--center" />
        <p class="text-lead">Primary service area is NSW, ACT and VIC, with national capability for larger projects.</p>
      </div>

      <div class="areas-grid">
        {[
          { state: 'NSW', label: 'New South Wales', primary: true, desc: 'Primary service area — Sydney, Newcastle, Wollongong, Central West, Hunter Valley and beyond.' },
          { state: 'ACT', label: 'Australian Capital Territory', primary: true, desc: 'Primary service area — Canberra metro and surrounding regions.' },
          { state: 'VIC', label: 'Victoria', primary: true, desc: 'Primary service area — Melbourne, Geelong, Ballarat, regional Victoria.' },
          { state: 'QLD', label: 'Queensland', primary: false, desc: 'Available for commercial and mine rehabilitation projects.' },
          { state: 'SA', label: 'South Australia', primary: false, desc: 'Available for commercial and mine rehabilitation projects.' },
          { state: 'WA', label: 'Western Australia', primary: false, desc: 'Available for large-scale mine rehabilitation and commercial projects.' },
          { state: 'NT', label: 'Northern Territory', primary: false, desc: 'Available for mine rehabilitation and large commercial projects.' },
          { state: 'TAS', label: 'Tasmania', primary: false, desc: 'Available for commercial projects — contact us to discuss.' },
        ].map(a => (
          <div class:list={['area-card', { 'area-card--primary': a.primary }]}>
            <span class="area-state">{a.state}</span>
            <span class="area-label">{a.label}</span>
            <p class="area-desc">{a.desc}</p>
            {a.primary && <span class="area-badge">Primary Area</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    heading="Ready to Work With Us?"
    subheading="Contact our team for a free site assessment and quote. We service all of Australia, with primary focus on NSW, ACT and VIC."
  />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 320px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }
  .page-hero-bg { position: absolute; inset: 0; }
  .page-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .page-hero-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, oklch(18% 0.07 148 / 0.88), oklch(24% 0.09 148 / 0.72)); }
  .page-hero-inner { position: relative; z-index: 1; padding-block: clamp(3rem, 6vh, 6rem); display: flex; flex-direction: column; gap: var(--space-4); }

  /* Story */
  .about-story {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .about-story-text { display: flex; flex-direction: column; gap: var(--space-4); }
  .about-story-text h2 { font-size: var(--text-4xl); color: var(--color-green-900); margin: var(--space-3) 0 0; }
  .about-story-img { border-radius: var(--radius-xl); overflow: hidden; }
  .about-story-img img { width: 100%; height: 400px; object-fit: cover; }

  @media (min-width: 768px) {
    .about-story { grid-template-columns: 1fr 1fr; }
    .about-story-img img { height: 520px; }
  }

  /* Values */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }

  .value-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    transition: transform var(--duration-normal), box-shadow var(--duration-normal), border-color var(--duration-normal);
  }

  .value-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-teal-300);
  }

  .value-icon { font-size: 2rem; display: block; margin-bottom: var(--space-4); }
  .value-title { font-size: var(--text-xl); color: var(--color-green-900); margin-bottom: var(--space-3); }
  .value-body { font-size: var(--text-sm); color: var(--color-earth-600); line-height: var(--leading-normal); }

  /* Areas */
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
  }

  .area-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    position: relative;
  }

  .area-card--primary {
    background: var(--color-green-50);
    border-color: var(--color-green-300);
  }

  .area-state {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-green-700);
    margin-bottom: var(--space-1);
  }

  .area-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-earth-500);
    margin-bottom: var(--space-3);
  }

  .area-desc { font-size: var(--text-sm); color: var(--color-earth-600); }

  .area-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-teal-500);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
  }
</style>
