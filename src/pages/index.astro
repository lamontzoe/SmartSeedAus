---
import BaseLayout from '../components/layout/BaseLayout.astro';
import HomeHero from '../components/hero/HomeHero.astro';
import Marquee from '../components/sections/Marquee.astro';
import ServiceCards from '../components/sections/ServiceCards.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import CoverageMap from '../components/sections/CoverageMap.tsx';
import BeforeAfter from '../components/sections/BeforeAfter.tsx';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<BaseLayout
  title="Smart Seed Australia"
  description="Australia's hydroseeding specialists. Professional hydroseeding, hydromulching, and watering services for residential, commercial, and mine rehabilitation projects across NSW, ACT, VIC and all of Australia. Get a free quote today."
  breadcrumbs={[{ name: 'Home', url: 'https://smartseedaustralia.com/' }]}
>
  <HomeHero />
  <Marquee />
  <ServiceCards />
  <ProcessSteps />
  <CoverageMap client:visible />
  <BeforeAfter client:visible />
  <FaqSection />
  <ContactSection />
</BaseLayout>

<style>
  /* Ensure body has the cream background even before sections load */
  body {
    background-color: var(--color-bg);
  }
</style>
