---
import SpraySimulation from './SpraySimulation.tsx';
import { SITE_PHONE, SITE_PHONE_RAW } from '../../lib/seo';
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <!-- Animated canvas spray simulation -->
  <div class="spray-stage" aria-hidden="true">
    <SpraySimulation client:only="preact" />
  </div>

  <!-- Hero content -->
  <div class="container hero-inner">
    <!-- Meta row -->
    <div class="hero-meta">
      <span class="hero-meta-dot" aria-hidden="true">•</span>
      <span>Now servicing <strong>ACT · NSW · VIC</strong></span>
      <span class="hero-meta-sep" aria-hidden="true">|</span>
      <span class="mono hero-est">EST. 2021</span>
    </div>

    <!-- Main headline -->
    <h1 id="hero-heading" class="hero-title">
      We grow the ground <em>back.</em>
    </h1>

    <!-- Sub row: description + CTAs -->
    <div class="hero-sub-row">
      <p class="hero-desc">
        Professional hydroseeding, hydromulching, and watering for residential, commercial, and mine rehabilitation sites across Australia.
      </p>
      <div class="hero-ctas">
        <a href="/quote/" class="btn-hero-primary">Get a free quote</a>
        <a href={`tel:${SITE_PHONE_RAW}`} class="btn-hero-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.5 2 2 0 0 1 3.54 1.31h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.92 16z"/></svg>
          {SITE_PHONE}
        </a>
      </div>
    </div>

    <!-- Vertical scroll label -->
    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll-text">Scroll — 01 / 07</span>
      <div class="hero-scroll-line"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding-top: 8rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* Canvas spray stage */
  .spray-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Content layer */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: clamp(2rem, 6vh, 6rem);
    max-width: 780px;
  }

  /* Meta row */
  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-teal-700);
    font-family: var(--font-mono);
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.1s both;
  }

  .hero-meta strong { color: var(--color-green-800); }
  .hero-meta-dot { color: var(--color-teal-500); }
  .hero-meta-sep { color: var(--color-border-strong); }
  .hero-est { color: var(--color-earth-400); letter-spacing: 0.08em; }

  /* Headline */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 5vw, 6.5rem);
    line-height: var(--leading-tight);
    color: var(--color-green-900);
    margin: 0;
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.2s both;
  }

  .hero-title em {
    font-style: italic;
    color: var(--color-teal-700);
  }

  /* Sub row */
  .hero-sub-row {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.3s both;
  }

  .hero-desc {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-earth-700);
    max-width: 46ch;
    margin: 0;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-7);
    background: var(--amber);
    color: #fff;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast), transform var(--duration-fast);
  }

  .btn-hero-primary:hover {
    background: #c8871a;
    transform: translateY(-1px);
  }

  .btn-hero-outline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: transparent;
    color: var(--color-green-700);
    border: 1.5px solid var(--color-green-700);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast), color var(--duration-fast);
  }

  .btn-hero-outline:hover {
    background: var(--color-green-700);
    color: #fff;
  }

  /* Scroll indicator — vertical, bottom right */
  .hero-scroll {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    z-index: 2;
    animation: fadeIn 1s 1s both;
  }

  .hero-scroll-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--color-earth-400);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
  }

  .hero-scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, var(--color-teal-300), transparent);
  }

  /* Responsive */
  @media (min-width: 768px) {
    .hero-sub-row {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .hero-scroll { display: none; }
    .hero-meta-sep { display: none; }
    .hero-est { display: none; }
  }
</style>
