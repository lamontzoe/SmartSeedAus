---
import { SITE_PHONE, SITE_PHONE_RAW } from '../../lib/seo';
---

<section class="hero" aria-labelledby="hero-heading">
  <!-- Background image with overlay -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=1920&q=85&auto=format&fit=crop"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-bg-img parallax-hero-img"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <span class="text-eyebrow hero-eyebrow">Australia's Hydroseeding Specialists</span>

      <h1 id="hero-heading" class="hero-heading">
        Transforming Bare Ground
        <em>Into Thriving Landscapes</em>
      </h1>

      <p class="hero-description">
        Professional hydroseeding, hydromulching, and watering services for residential, commercial, and mine rehabilitation projects. Proudly servicing NSW, ACT, VIC and all of Australia.
      </p>

      <div class="hero-ctas">
        <a href="/quote/" class="btn btn--quote btn--lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          Get a Free Quote
        </a>
        <a href={`tel:${SITE_PHONE_RAW}`} class="btn btn--outline-inv btn--lg hero-phone-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.5 2 2 0 0 1 3.54 1.31h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.92 16z"/></svg>
          {SITE_PHONE}
        </a>
      </div>
    </div>

    <!-- Trust card -->
    <div class="hero-trust-card">
      <div class="trust-stat">
        <span class="trust-num">500+</span>
        <span class="trust-label">Projects Completed</span>
      </div>
      <div class="trust-divider" aria-hidden="true"></div>
      <div class="trust-stat">
        <span class="trust-num">15+</span>
        <span class="trust-label">Years Experience</span>
      </div>
      <div class="trust-divider" aria-hidden="true"></div>
      <div class="trust-stat">
        <span class="trust-num">All<br/>States</span>
        <span class="trust-label">Australia-Wide</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll" aria-hidden="true">
    <div class="hero-scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 88vh, 900px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    color: #fff;
  }

  /* Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      oklch(18% 0.07 148 / 0.88) 0%,
      oklch(24% 0.09 148 / 0.72) 50%,
      oklch(28% 0.08 195 / 0.60) 100%
    );
  }

  /* Content */
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(4rem, 8vh, 8rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .hero-content {
    max-width: 680px;
  }

  .hero-eyebrow {
    color: var(--color-teal-300);
    margin-bottom: var(--space-5);
    display: block;
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.1s both;
  }

  .hero-heading {
    font-size: var(--text-hero);
    color: #fff;
    margin-bottom: var(--space-6);
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.2s both;
  }

  .hero-heading em {
    display: block;
    font-style: italic;
    color: var(--color-green-300);
  }

  .hero-description {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: oklch(90% 0.03 148);
    max-width: 54ch;
    margin-bottom: var(--space-8);
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.3s both;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.4s both;
  }

  /* Trust card */
  .hero-trust-card {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    width: fit-content;
    animation: fadeUp var(--duration-slow) var(--ease-out-expo) 0.5s both;
  }

  .trust-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .trust-num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: #fff;
    line-height: 1;
  }

  .trust-label {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-green-300);
    margin-top: var(--space-1);
  }

  .trust-divider {
    width: 1px;
    height: 2.5rem;
    background: rgba(255, 255, 255, 0.2);
  }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .hero-scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
    margin: 0 auto;
    animation: fadeIn 1s 1s both;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .hero-trust-card {
      gap: var(--space-4);
      padding: var(--space-4) var(--space-5);
    }
    .trust-num { font-size: var(--text-2xl); }
    .hero-phone-btn { display: none; }
  }

  @media (min-width: 1024px) {
    .hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .hero-trust-card {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
      flex-shrink: 0;
    }
    .trust-divider {
      width: 2rem;
      height: 1px;
    }
    .trust-stat { align-items: flex-start; text-align: left; }
  }
</style>
