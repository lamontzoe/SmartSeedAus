---
import { SITE_PHONE, SITE_PHONE_RAW } from '../../lib/seo';

interface Props {
  heading?: string;
  subheading?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  heading = 'Ready to Transform Your Site?',
  subheading = 'Get a free, no-obligation quote. Our team will assess your site and recommend the best approach for fast, lasting results.',
  primaryLabel = 'Get a Free Quote',
  primaryHref = '/quote/',
} = Astro.props;
---

<section class="cta-banner" aria-labelledby="cta-heading">
  <div class="cta-banner-bg" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1590212151175-e58edd96185b?w=1440&q=80&auto=format&fit=crop"
      alt=""
      width="1440"
      height="600"
      loading="lazy"
    />
    <div class="cta-banner-overlay"></div>
  </div>

  <div class="container cta-banner-inner">
    <div class="cta-banner-content reveal">
      <span class="text-eyebrow" style="color: var(--color-teal-300);">Start Today</span>
      <h2 id="cta-heading" style="color: #fff; font-size: var(--text-4xl);">{heading}</h2>
      <p style="color: var(--color-green-100); font-size: var(--text-lg); max-width: 52ch;">{subheading}</p>
    </div>

    <div class="cta-banner-actions reveal">
      <a href={primaryHref} class="btn btn--quote btn--lg">{primaryLabel}</a>
      <a href={`tel:${SITE_PHONE_RAW}`} class="btn btn--outline-inv btn--lg">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.5 2 2 0 0 1 3.54 1.31h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.92 16z"/></svg>
        {SITE_PHONE}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section);
    color: #fff;
  }

  .cta-banner-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-banner-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  .cta-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      oklch(18% 0.07 148 / 0.92) 0%,
      oklch(24% 0.09 148 / 0.80) 100%
    );
  }

  .cta-banner-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .cta-banner-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cta-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 768px) {
    .cta-banner-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .cta-banner-content { flex: 1; }
    .cta-banner-actions { flex-shrink: 0; flex-direction: column; align-items: stretch; }
  }
</style>
