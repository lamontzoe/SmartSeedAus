---
const testimonials = [
  {
    name: 'James R.',
    location: 'Canberra, ACT',
    project: 'Residential lawn — new build',
    rating: 5,
    text: 'We tried sod and failed twice after our new build. Smart Seed came out, assessed the soil properly and within 6 weeks we had the best lawn in the street. Genuinely impressed by the professionalism and result.',
    avatar: 'J',
  },
  {
    name: 'Sarah & Tom M.',
    location: 'Blue Mountains, NSW',
    project: 'Erosion control — steep block',
    rating: 5,
    text: 'Our property had serious erosion issues after some earthworks. Smart Seed handled the whole slope, and the coverage was perfect. They were on time, tidy, and the result speaks for itself. Highly recommended.',
    avatar: 'S',
  },
  {
    name: 'Craig D.',
    location: 'Geelong, VIC',
    project: 'Commercial development — 2ha site',
    rating: 5,
    text: 'Used Smart Seed across a 2-hectare commercial site. They coordinated around our construction schedule, hit every deadline and the revegetation passed council inspection first go. Brilliant.',
    avatar: 'C',
  },
  {
    name: 'Lynda P.',
    location: 'Hunter Valley, NSW',
    project: 'Mine rehabilitation',
    rating: 5,
    text: 'The team understood our environmental obligations from day one. Native species mix, proper documentation, and ongoing support through the establishment phase. Couldn\'t ask for more.',
    avatar: 'L',
  },
];
---

<section class="section section--dark testimonials-section" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="section-header text-inv reveal">
      <span class="text-eyebrow" style="color: var(--color-teal-300);">Client Stories</span>
      <h2 id="testimonials-heading" style="color: #fff;">Real Results Across Australia</h2>
      <hr class="divider divider--center" style="background: var(--color-teal-500);" />
      <p class="text-lead" style="color: var(--color-green-200); margin-inline: auto;">From residential backyards to major mine rehabilitation — our clients trust us to deliver.</p>
    </div>

    <div class="testimonials-grid reveal-stagger">
      {testimonials.map((t, i) => (
        <article class="testimonial-card testimonial-hover" style={`--card-index: ${i}`}>
          <div class="testimonial-stars" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.122 2.122 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
            ))}
          </div>

          <blockquote class="testimonial-text">
            <p>"{t.text}"</p>
          </blockquote>

          <footer class="testimonial-footer">
            <div class="testimonial-avatar" aria-hidden="true">{t.avatar}</div>
            <div>
              <p class="testimonial-name">{t.name}</p>
              <p class="testimonial-location">{t.location} · {t.project}</p>
            </div>
          </footer>
        </article>
      ))}
    </div>

    <div style="text-align:center; margin-top: var(--space-12);">
      <a href="/contact/" class="btn btn--outline-inv btn--lg">Share Your Experience</a>
    </div>
  </div>
</section>

<style>
  .testimonials-section { position: relative; overflow: hidden; }

  /* Decorative grain overlay */
  .testimonials-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
  }

  .container { position: relative; z-index: 1; }

  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .testimonial-card {
    background: oklch(28% 0.09 148 / 0.6);
    border: 1px solid oklch(40% 0.09 148 / 0.5);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    backdrop-filter: blur(8px);
    transition: transform var(--duration-normal), border-color var(--duration-normal);
  }

  .testimonial-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-teal-500);
  }

  .testimonial-stars {
    display: flex;
    gap: 2px;
    color: var(--color-quote);
    margin-bottom: var(--space-5);
  }

  .testimonial-text {
    margin-bottom: var(--space-6);
  }

  .testimonial-text p {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-green-100);
    font-style: italic;
    font-family: var(--font-display);
    max-width: 100%;
  }

  .testimonial-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .testimonial-avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    background: var(--color-teal-700);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .testimonial-name {
    font-weight: 600;
    color: #fff;
    font-size: var(--text-sm);
    max-width: 100%;
  }

  .testimonial-location {
    font-size: var(--text-xs);
    color: var(--color-green-400);
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .testimonials-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
