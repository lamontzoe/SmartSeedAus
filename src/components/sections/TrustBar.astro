---
const stats = [
  { value: 500, suffix: '+', label: 'Projects Completed', icon: 'trophy' },
  { value: 15,  suffix: '+', label: 'Years Experience',   icon: 'calendar' },
  { value: 10,  suffix: 'M+', prefix: '', label: 'Square Metres Seeded', icon: 'leaf' },
  { value: 100, suffix: '%', label: 'Client Focus',       icon: 'star' },
  { value: 8,   suffix: '',  label: 'States Serviced',    icon: 'map' },
];

const icons: Record<string, string> = {
  trophy: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>`,
  calendar: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`,
  leaf: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  star: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.122 2.122 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>`,
  map: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>`,
};
---

<div class="trust-bar section--sm reveal" aria-label="Trust statistics">
  <div class="container">
    <ul class="trust-bar-list reveal-stagger" role="list">
      {stats.map((stat, i) => (
        <li class="trust-bar-item">
          <div class="trust-bar-icon-wrap" aria-hidden="true" set:html={icons[stat.icon]} />
          <span
            class="trust-bar-value counter-value"
            data-counter
            data-target={stat.value}
            data-suffix={stat.suffix}
            data-prefix={stat.prefix ?? ''}
            data-duration="1600"
            aria-label={`${stat.value}${stat.suffix} ${stat.label}`}
          >0</span>
          <span class="trust-bar-label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .trust-bar {
    background: var(--color-green-900);
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  /* Subtle animated gradient shimmer */
  .trust-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 0%,
      oklch(40% 0.09 148 / 0.15) 40%,
      transparent 80%
    );
    background-size: 200% 100%;
    animation: barShimmer 4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes barShimmer {
    0%, 100% { background-position: 200% 0; }
    50%       { background-position: -200% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-bar::before { animation: none; }
  }

  .trust-bar-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-8) var(--space-12);
    position: relative;
  }

  .trust-bar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .trust-bar-icon-wrap {
    color: var(--color-teal-300);
    opacity: 0.85;
    transition: opacity var(--duration-fast), transform var(--duration-normal) var(--ease-spring);
  }

  .trust-bar-item:hover .trust-bar-icon-wrap {
    opacity: 1;
    transform: scale(1.15) translateY(-2px);
  }

  .trust-bar-value {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: #fff;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    cursor: default;
  }

  .trust-bar-label {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-green-300);
  }

  @media (min-width: 768px) {
    .trust-bar-list { gap: var(--space-4) var(--space-16); }
  }
</style>
