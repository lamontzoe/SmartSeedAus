---
const principles = [
  {
    n: '01',
    title: 'Sustainability',
    body: 'Eco-conscious slurries, native seed blends where it matters, and equipment tuned for minimal footprint on site.',
  },
  {
    n: '02',
    title: 'Precision',
    body: 'State-of-the-art spray rigs with calibrated pressure and flow — measurable coverage rather than guesswork.',
  },
  {
    n: '03',
    title: 'Country',
    body: 'Working with, not against, the landscape. Tailored approaches for ACT, NSW and Victorian soils and climates.',
  },
];
---

<section class="philosophy-section" id="about" aria-labelledby="philosophy-heading">
  <div class="container">
    <div class="section-label-wrap">
      <span class="section-label">Philosophy · 03</span>
    </div>

    <h2 id="philosophy-heading" class="philosophy-title">
      A living <em>standard.</em>
    </h2>

    <p class="philosophy-lead">
      Smart Seed Australia exists to revitalise landscapes through innovative hydroseeding, hydromulching and land restoration — promoting sustainable growth and a <em>harmonious relationship</em> between nature and the communities that live in it.
    </p>

    <div class="principles-grid">
      {principles.map(p => (
        <div class="principle-card">
          <div class="principle-top">
            <span class="principle-num">{p.n}</span>
          </div>
          <h3 class="principle-title">{p.title}</h3>
          <p class="principle-body">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .philosophy-section {
    padding-block: var(--space-section);
    background: var(--color-green-900);
    color: var(--color-text-inv);
    position: relative;
    overflow: hidden;
  }

  /* Subtle grain overlay */
  .philosophy-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.3;
    mix-blend-mode: overlay;
  }

  .container { position: relative; z-index: 1; }

  .section-label-wrap {
    margin-bottom: var(--space-6);
  }

  .philosophy-section .section-label {
    color: var(--color-teal-300);
    border-color: var(--color-teal-700);
  }

  .philosophy-section .section-label::before {
    background: var(--color-teal-700);
  }

  .philosophy-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: #fff;
    margin-bottom: var(--space-6);
  }

  .philosophy-title em {
    font-style: italic;
    color: var(--color-teal-300);
  }

  .philosophy-lead {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-green-200);
    max-width: 64ch;
    margin-bottom: var(--space-12);
  }

  .philosophy-lead em {
    font-style: italic;
    color: var(--color-teal-300);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .principles-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .principle-card {
    border-top: 1px solid oklch(40% 0.09 148 / 0.5);
    padding-top: var(--space-5);
  }

  .principle-top {
    margin-bottom: var(--space-4);
  }

  .principle-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--amber);
    letter-spacing: 0.08em;
  }

  .principle-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: #fff;
    margin-bottom: var(--space-3);
  }

  .principle-body {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-green-200);
  }
</style>
