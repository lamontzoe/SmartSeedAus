---
const services = [
  {
    n: '01',
    name: 'Hydro',
    nameEm: 'seeding',
    desc: 'Uniform slurry of water, seed, mulch and tackifier sprayed across prepared soil for dense, fast-establishing green cover at a fraction of the cost of traditional seeding.',
    imgUrl: 'https://images.unsplash.com/photo-1586771107445-d3ca888129ff?auto=format&fit=crop&w=1200&q=80',
    imgAlt: 'Hydroseeding spray rig in action',
    stats: [
      ['Coverage', 'Up to 4 ha / day'],
      ['Germination', '7–14 days'],
      ['Best for', 'Lawns · acreage · batters'],
      ['Warranty', '90 days establishment'],
    ],
  },
  {
    n: '02',
    name: 'Hydro',
    nameEm: 'mulching',
    desc: 'Heavier fibre-mulch blend with seed and fertiliser designed to stabilise soil and control erosion on steep or vulnerable ground while establishing rapid vegetation.',
    imgUrl: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=80',
    imgAlt: 'Rehabilitated batter with green cover',
    stats: [
      ['Coverage', 'Up to 3 ha / day'],
      ['Slope', 'Up to 45°'],
      ['Best for', 'Mine sites · batters · rehab'],
      ['Mulch rate', '2,500 kg / ha'],
    ],
  },
  {
    n: '03',
    name: 'Wa',
    nameEm: 'tering',
    desc: 'Scheduled, precision watering to keep establishment on track. Tanker delivery, pressure control and moisture mapping for consistent, measurable irrigation.',
    imgUrl: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1200&q=80',
    imgAlt: 'Irrigation watering in golden hour',
    stats: [
      ['Capacity', 'Up to 14,000 L / load'],
      ['Frequency', 'Daily / weekly plans'],
      ['Best for', 'New seed · turf · revegetation'],
      ['Coverage proof', 'GPS + flow log'],
    ],
  },
  {
    n: '04',
    name: 'Mine ',
    nameEm: 'Rehabilitation',
    desc: 'Specialist revegetation for mine sites, tailings dams, and disturbed land. We meet regulatory standards and create resilient, self-sustaining native ecosystems.',
    imgUrl: 'https://images.unsplash.com/photo-1574623452334-1e0ac2b3ccb4?auto=format&fit=crop&w=1200&q=80',
    imgAlt: 'Mine site rehabilitation revegetation',
    stats: [
      ['Species', 'Native & local provenance'],
      ['Compliance', 'Regulatory reporting'],
      ['Scale', 'Any project size'],
      ['Support', 'Establishment monitoring'],
    ],
  },
  {
    n: '05',
    name: 'Commercial ',
    nameEm: 'Projects',
    desc: 'Large-scale hydroseeding for developers, councils, road corridors, sporting fields, and infrastructure projects. Compliant with environmental conditions.',
    imgUrl: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80',
    imgAlt: 'Commercial construction site revegetation',
    stats: [
      ['Scale', 'Any size project'],
      ['Reporting', 'Compliance documentation'],
      ['PM', 'Full project management'],
      ['Timing', 'Works around your schedule'],
    ],
  },
];
---

<section class="services-section" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-label-wrap">
      <span class="section-label">Services · 02</span>
    </div>
    <div class="services-intro">
      <h2 id="services-heading" class="services-title">What we <em>do</em>.</h2>
      <p class="services-lead">
        Three integrated services, one outcome: durable ground cover that performs. We scope, spray and water with the same crew and equipment — so what we promise matches what comes up out of the soil.
      </p>
    </div>

    <div class="service-list" role="list">
      {services.map((s, i) => (
        <div
          class="service-row"
          role="listitem"
          data-index={i}
          aria-expanded="false"
        >
          <div class="service-row-header" role="button" tabindex="0" aria-controls={`service-expand-${i}`} aria-expanded="false">
            <span class="service-num mono">{s.n}</span>
            <span class="service-name">
              {s.name}<em>{s.nameEm}</em>
            </span>
            <span class="service-desc-inline">{s.desc}</span>
            <span class="service-toggle" aria-hidden="true">+</span>
          </div>

          <div class="service-expand" id={`service-expand-${i}`} aria-hidden="true">
            <div></div>
            <div class="service-expand-img">
              <img
                src={s.imgUrl}
                alt={s.imgAlt}
                width="1200"
                height="750"
                loading="lazy"
              />
            </div>
            <div class="service-stats">
              {s.stats.map(([k, v]) => (
                <div class="service-stat">
                  <span class="stat-key mono">{k}</span>
                  <span class="stat-val">{v}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="services-cta">
      <a href="/services/" class="btn-services-more">View all services →</a>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding-block: var(--space-section);
    background: var(--color-bg);
  }

  .section-label-wrap {
    margin-bottom: var(--space-6);
  }

  .services-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .services-intro {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-12);
    }
  }

  .services-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-green-900);
    flex-shrink: 0;
    margin: 0;
  }

  .services-title em {
    font-style: italic;
    color: var(--color-teal-700);
  }

  .services-lead {
    font-size: var(--text-base);
    color: var(--color-earth-600);
    line-height: var(--leading-normal);
    max-width: 56ch;
    margin: 0;
  }

  /* Service accordion */
  .service-list {
    border-top: 1px solid var(--color-border);
  }

  .service-row {
    border-bottom: 1px solid var(--color-border);
  }

  .service-row-header {
    display: grid;
    grid-template-columns: 70px 1fr 1.4fr 48px;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-5);
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  .service-row-header:hover {
    background: var(--color-earth-100);
  }

  .service-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-earth-400);
  }

  .service-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-green-900);
  }

  .service-name em {
    font-style: italic;
    color: var(--color-teal-700);
  }

  .service-desc-inline {
    display: none;
    font-size: var(--text-sm);
    color: var(--color-earth-600);
    line-height: var(--leading-normal);
  }

  @media (min-width: 768px) {
    .service-desc-inline { display: block; }
  }

  .service-toggle {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-green-700);
    transition: transform var(--duration-normal) var(--ease-out-expo), background var(--duration-fast);
    flex-shrink: 0;
    margin-left: auto;
    user-select: none;
  }

  /* Open state */
  .service-row.open .service-toggle {
    transform: rotate(45deg);
    background: var(--color-green-700);
    color: #fff;
    border-color: var(--color-green-700);
  }

  /* Expand panel */
  .service-expand {
    display: grid;
    grid-template-columns: 70px 1fr 1fr;
    gap: var(--space-6);
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height var(--duration-slow) var(--ease-out-expo), opacity var(--duration-normal), padding var(--duration-normal);
    pointer-events: none;
  }

  .service-row.open .service-expand {
    max-height: 600px;
    opacity: 1;
    padding-bottom: var(--space-8);
    pointer-events: auto;
  }

  .service-expand-img {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    aspect-ratio: 16 / 10;
  }

  .service-expand-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .service-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .service-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .service-stat:last-child { border-bottom: none; padding-bottom: 0; }

  .stat-key {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-earth-400);
  }

  .stat-val {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-green-900);
  }

  /* Mobile: collapse expand columns */
  @media (max-width: 640px) {
    .service-row-header {
      grid-template-columns: 40px 1fr 36px;
    }
    .service-expand {
      grid-template-columns: 1fr;
    }
    .service-expand > div:first-child { display: none; }
  }

  .services-cta {
    margin-top: var(--space-10);
    text-align: right;
  }

  .btn-services-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-green-700);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .btn-services-more:hover { color: var(--color-green-800); }
</style>

<script>
  const rows = document.querySelectorAll('.service-row');

  rows.forEach(row => {
    const header = row.querySelector('.service-row-header') as HTMLElement;
    const expand = row.querySelector('.service-expand') as HTMLElement;
    const toggle = row.querySelector('.service-toggle') as HTMLElement;

    const open = () => {
      row.classList.add('open');
      header.setAttribute('aria-expanded', 'true');
      expand.setAttribute('aria-hidden', 'false');
    };

    const close = () => {
      row.classList.remove('open');
      header.setAttribute('aria-expanded', 'false');
      expand.setAttribute('aria-hidden', 'true');
    };

    const toggleRow = () => {
      if (row.classList.contains('open')) {
        close();
      } else {
        // Close other open rows
        rows.forEach(r => {
          if (r !== row && r.classList.contains('open')) {
            r.classList.remove('open');
            (r.querySelector('.service-row-header') as HTMLElement)?.setAttribute('aria-expanded', 'false');
            (r.querySelector('.service-expand') as HTMLElement)?.setAttribute('aria-hidden', 'true');
          }
        });
        open();
      }
    };

    header.addEventListener('click', toggleRow);
    header.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleRow();
      }
    });
  });

  // Open first row by default
  if (rows.length > 0) {
    const firstHeader = rows[0].querySelector('.service-row-header') as HTMLElement;
    const firstExpand = rows[0].querySelector('.service-expand') as HTMLElement;
    rows[0].classList.add('open');
    firstHeader?.setAttribute('aria-expanded', 'true');
    firstExpand?.setAttribute('aria-hidden', 'false');
  }
</script>
