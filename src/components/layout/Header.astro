---
import { SITE_NAME, SITE_PHONE, SITE_PHONE_RAW } from '../../lib/seo';

const navLinks = [
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <!-- Logo -->
    <a href="/" class="header-logo" aria-label={`${SITE_NAME} — Home`}>
      <img
        src="/images/logo.png"
        alt={SITE_NAME}
        width="52"
        height="52"
        loading="eager"
        fetchpriority="high"
      />
      <span class="header-logo-text">
        <span class="header-logo-name">Smart Seed</span>
        <span class="header-logo-sub">Australia</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label="Main navigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': currentPath.startsWith(link.href) }]}
              aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header CTAs -->
    <div class="header-actions">
      <a href={`tel:${SITE_PHONE_RAW}`} class="header-phone" aria-label={`Call us: ${SITE_PHONE}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.5 2 2 0 0 1 3.54 1.31h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.92 16z"/>
        </svg>
        <span>{SITE_PHONE}</span>
      </a>
      <a href="/quote/" class="btn btn--primary">Get a Free Quote</a>
    </div>

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation menu">
      <span class="mobile-menu-bar"></span>
      <span class="mobile-menu-bar"></span>
      <span class="mobile-menu-bar"></span>
    </button>
  </div>

  <!-- Mobile nav -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
          </li>
        ))}
        <li>
          <a href={`tel:${SITE_PHONE_RAW}`} class="mobile-nav-link mobile-nav-link--phone">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.5 2 2 0 0 1 3.54 1.31h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.92 16z"/>
            </svg>
            {SITE_PHONE}
          </a>
        </li>
        <li><a href="/quote/" class="btn btn--primary" style="display:block;text-align:center;margin-top:0.5rem;">Get a Free Quote</a></li>
      </ul>
    </nav>
  </div>
</header>

<!-- Mobile sticky phone bar -->
<div class="mobile-phone-bar">
  <a href={`tel:${SITE_PHONE_RAW}`} class="mobile-phone-bar-link">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.5 2 2 0 0 1 3.54 1.31h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.92 16z"/>
    </svg>
    Call Now
  </a>
  <a href="/quote/" class="mobile-phone-bar-quote">Free Quote</a>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 0 var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 4rem;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    text-decoration: none;
  }

  .header-logo img {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .header-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .header-logo-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-green-900);
    font-weight: 400;
  }

  .header-logo-sub {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-teal-500);
  }

  /* Desktop nav */
  .header-nav {
    flex: 1;
    display: none;
  }

  .header-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-earth-700);
    border-radius: var(--radius-md);
    transition: color var(--duration-fast), background var(--duration-fast);
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-green-700);
    background: var(--color-green-50);
  }

  /* Header actions */
  .header-actions {
    display: none;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  .header-phone {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-earth-700);
    transition: color var(--duration-fast);
  }

  .header-phone:hover { color: var(--color-green-700); }

  /* Buttons */
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast), transform var(--duration-fast), box-shadow var(--duration-fast);
    white-space: nowrap;
  }

  :global(.btn--primary) {
    background: var(--color-green-700);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }

  :global(.btn--primary:hover) {
    background: var(--color-green-800);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  :global(.btn--quote) {
    background: var(--color-quote);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }

  :global(.btn--quote:hover) {
    background: #c8871a;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  :global(.btn--outline) {
    background: transparent;
    color: var(--color-green-700);
    border: 2px solid var(--color-green-700);
  }

  :global(.btn--outline:hover) {
    background: var(--color-green-700);
    color: #fff;
  }

  :global(.btn--outline-inv) {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.6);
  }

  :global(.btn--outline-inv:hover) {
    background: rgba(255,255,255,0.15);
    border-color: #fff;
  }

  :global(.btn--lg) {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-base);
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
    margin-left: auto;
    border-radius: var(--radius-sm);
    cursor: pointer;
    background: transparent;
    border: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-earth-700);
    border-radius: var(--radius-full);
    transition: transform var(--duration-normal) var(--ease-out-expo), opacity var(--duration-normal);
  }

  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    border-top: 1px solid var(--color-border);
    background: #fff;
    padding: var(--space-4) var(--space-6);
  }

  .mobile-menu[aria-hidden="false"] {
    display: block;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-earth-700);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--duration-fast);
  }

  .mobile-nav-link:last-of-type { border-bottom: none; }
  .mobile-nav-link:hover { color: var(--color-green-700); }
  .mobile-nav-link--phone { color: var(--color-green-700); }

  /* Mobile sticky phone bar */
  .mobile-phone-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
    display: flex;
    background: var(--color-green-900);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .mobile-phone-bar-link,
  .mobile-phone-bar-quote {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    font-weight: 600;
    font-size: var(--text-sm);
    color: #fff;
    text-decoration: none;
    transition: background var(--duration-fast);
  }

  .mobile-phone-bar-link { border-right: 1px solid oklch(40% 0.09 148 / 0.5); }
  .mobile-phone-bar-link:hover { background: var(--color-green-800); }

  .mobile-phone-bar-quote {
    background: var(--color-quote);
  }
  .mobile-phone-bar-quote:hover { background: #c8871a; }

  /* Responsive */
  @media (min-width: 768px) {
    .mobile-menu-btn { display: none; }
    .mobile-phone-bar { display: none; }
    .header-nav { display: flex; }
    .header-actions { display: flex; }
    body { padding-bottom: 0; }
  }

  @media (max-width: 767px) {
    body { padding-bottom: 60px; }
    .header-logo-sub { display: none; }
  }
</style>

<script>
  const btn = document.querySelector('.mobile-menu-btn') as HTMLButtonElement;
  const menu = document.querySelector('.mobile-menu') as HTMLElement;

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu.setAttribute('aria-hidden', String(expanded));
  });
</script>
