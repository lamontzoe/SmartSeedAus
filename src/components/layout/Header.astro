---
import { SITE_NAME } from '../../lib/seo';

const navLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/#about', label: 'Philosophy' },
  { href: '/#coverage', label: 'Coverage' },
  { href: '/#results', label: 'Results' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <!-- Logo -->
    <a href="/" class="header-logo" aria-label={`${SITE_NAME} — Home`}>
      <img
        src="/images/logo.png"
        alt={SITE_NAME}
        width="44"
        height="44"
        loading="eager"
        fetchpriority="high"
      />
      <span class="header-logo-text">
        <span class="header-logo-name">Smart Seed</span>
        <span class="header-logo-sub">Australia</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label="Main navigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header CTA -->
    <div class="header-actions">
      <a href="/quote/" class="btn-cta">Get a quote</a>
    </div>

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation menu">
      <span class="mobile-menu-bar"></span>
      <span class="mobile-menu-bar"></span>
      <span class="mobile-menu-bar"></span>
    </button>
  </div>

  <!-- Mobile nav -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
          </li>
        ))}
        <li>
          <a href="/quote/" class="mobile-nav-cta">Get a quote →</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background var(--duration-normal),
      border-color var(--duration-normal),
      backdrop-filter var(--duration-normal);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 4.5rem;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    text-decoration: none;
  }

  .header-logo img {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
  }

  .header-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .header-logo-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-green-900);
    font-weight: 400;
  }

  .header-logo-sub {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  /* Desktop nav */
  .header-nav {
    flex: 1;
    display: none;
  }

  .header-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-earth-700);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: color var(--duration-fast), background var(--duration-fast);
  }

  .nav-link:hover {
    color: var(--color-green-700);
    background: var(--color-green-50);
  }

  /* Header CTA */
  .header-actions {
    display: none;
    align-items: center;
    margin-left: auto;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-5);
    background: var(--color-green-700);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast), transform var(--duration-fast);
  }

  .btn-cta:hover {
    background: var(--color-green-800);
    transform: translateY(-1px);
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
    margin-left: auto;
    border-radius: var(--radius-sm);
    cursor: pointer;
    background: transparent;
    border: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-earth-700);
    border-radius: var(--radius-full);
    transition: transform var(--duration-normal) var(--ease-out-expo), opacity var(--duration-normal);
  }

  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--space-4) var(--space-6) var(--space-6);
  }

  .mobile-menu[aria-hidden="false"] {
    display: block;
  }

  .mobile-nav-link {
    display: block;
    padding: var(--space-3) 0;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-earth-700);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .mobile-nav-link:hover { color: var(--color-green-700); }

  .mobile-nav-cta {
    display: block;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-6);
    background: var(--color-green-700);
    color: #fff;
    border-radius: var(--radius-full);
    text-align: center;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast);
  }

  .mobile-nav-cta:hover { background: var(--color-green-800); }

  /* Responsive */
  @media (min-width: 820px) {
    .mobile-menu-btn { display: none; }
    .header-nav { display: flex; }
    .header-actions { display: flex; }
  }
</style>

<script>
  // Mobile menu toggle
  const btn = document.querySelector('.mobile-menu-btn') as HTMLButtonElement;
  const menu = document.querySelector('.mobile-menu') as HTMLElement;

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu.setAttribute('aria-hidden', String(expanded));
  });

  // Transparent → frosted glass on scroll
  const header = document.querySelector('.site-header') as HTMLElement;
  const onScroll = () => {
    if (window.scrollY > 40) {
      header.classList.add('header--scrolled');
    } else {
      header.classList.remove('header--scrolled');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
