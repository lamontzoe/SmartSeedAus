---
import { SITE_NAME, SITE_PHONE, SITE_PHONE_RAW, SITE_EMAIL } from '../../lib/seo';

const services = [
  { href: '/services/hydroseeding/', label: 'Hydroseeding' },
  { href: '/services/hydromulching/', label: 'Hydromulching' },
  { href: '/services/commercial/', label: 'Commercial Projects' },
  { href: '/services/mine-rehabilitation/', label: 'Mine Rehabilitation' },
  { href: '/services/residential/', label: 'Residential' },
  { href: '/services/watering/', label: 'Watering Services' },
];

const company = [
  { href: '/about/', label: 'About Us' },
  { href: '/gallery/', label: 'Project Gallery' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
  { href: '/quote/', label: 'Get a Quote' },
];

const areas = ['NSW', 'ACT', 'VIC', 'QLD', 'SA', 'WA'];
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-top">
    <div class="container footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label={`${SITE_NAME} — Home`}>
          <img src="/images/logo.png" alt={SITE_NAME} width="56" height="56" loading="lazy" />
          <span class="footer-logo-text">
            <span class="footer-logo-name">Smart Seed</span>
            <span class="footer-logo-sub">Australia</span>
          </span>
        </a>
        <p class="footer-tagline">
          Australia's hydroseeding specialists — transforming bare ground into thriving, sustainable landscapes.
        </p>
        <div class="footer-contact-items">
          <a href={`tel:${SITE_PHONE_RAW}`} class="footer-contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.5 2 2 0 0 1 3.54 1.31h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.92 16z"/></svg>
            {SITE_PHONE}
          </a>
          <a href={`mailto:${SITE_EMAIL}`} class="footer-contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            {SITE_EMAIL}
          </a>
        </div>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <h3 class="footer-heading">Services</h3>
        <ul role="list" class="footer-links">
          {services.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div class="footer-col">
        <h3 class="footer-heading">Company</h3>
        <ul role="list" class="footer-links">
          {company.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Service Areas -->
      <div class="footer-col">
        <h3 class="footer-heading">Service Areas</h3>
        <p class="footer-areas-intro">Servicing all of Australia, with focus on:</p>
        <ul role="list" class="footer-areas">
          {areas.map(area => <li>{area}</li>)}
        </ul>
        <a href="/quote/" class="btn btn--quote" style="margin-top: 1.5rem; font-size: 0.875rem;">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <!-- Footer bottom -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copy">&copy; {currentYear} {SITE_NAME}. All rights reserved.</p>
      <p class="footer-copy footer-copy--muted">Professional hydroseeding services — NSW · ACT · VIC · Australia</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-green-950);
    color: var(--color-green-200);
  }

  .footer-top {
    padding-block: var(--space-16) var(--space-12);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    text-decoration: none;
  }

  .footer-logo img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    border-radius: var(--radius-sm);
    opacity: 0.92;
  }

  .footer-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .footer-logo-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: #fff;
  }

  .footer-logo-sub {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-teal-300);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-green-300);
    max-width: 32ch;
    margin-bottom: var(--space-6);
  }

  .footer-contact-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-green-200);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-contact-link:hover { color: #fff; }

  /* Columns */
  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-teal-300);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--color-green-300);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-link:hover { color: #fff; }

  .footer-areas-intro {
    font-size: var(--text-sm);
    color: var(--color-green-400);
    margin-bottom: var(--space-3);
    max-width: 100%;
  }

  .footer-areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer-areas li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: oklch(30% 0.09 148 / 0.6);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-green-200);
  }

  /* Bottom */
  .footer-bottom {
    border-top: 1px solid oklch(30% 0.09 148 / 0.5);
    padding-block: var(--space-6);
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    text-align: center;
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--color-green-400);
    max-width: 100%;
  }

  .footer-copy--muted { color: oklch(45% 0.07 148); }

  /* Responsive */
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
    }
    .footer-brand {
      grid-column: auto;
    }
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
